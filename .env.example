# Copy to .env — everything has a working default; with no keys at all the whole loop runs in simulated mode.

PORT=3000
# Public HTTPS URL of this server, so Vapi can post webhooks (ngrok/cloudflared tunnel or a host).
PUBLIC_URL=

# mock | vapi   (mock = scripted calls, marked SIMULATED in the app)
VOICE_PROVIDER=mock
# en | nl  — language the assistants speak
CALL_LANGUAGE=en
# When the proactive rule fires (short night + <500 steps after 10:00), call Mia automatically.
AUTO_CHECKIN=true

# Who we call (E.164). On a Twilio trial these must be verified caller IDs.
MIA_PHONE=
TOM_PHONE=
NEIGHBOUR_PHONE=

# Vapi (https://dashboard.vapi.ai) — import your Twilio number, copy its phoneNumberId.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Paige
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o

# Post-call analysis (any OpenAI-compatible endpoint). Missing key = keyword fallback, still works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=15000

# Family SMS via Twilio. Off by default; notifications are recorded as "simulated" instead.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Rules
ESCALATION_NO_ANSWER_MS=30000
CHECKIN_COOLDOWN_MS=600000
MAX_CALL_SECONDS=240

# Mock provider pacing (ms)
MOCK_RING_MS=2500
MOCK_TALK_MS=6000
MOCK_NO_ANSWER_MS=45000

DATA_FILE=data/store.json
